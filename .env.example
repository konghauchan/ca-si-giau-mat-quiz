DATABASE_PATH=./data/game.sqlite
MEDIA_DIR=./data/media
# Bản online: kết nối Turso qua biến môi trường do Vercel tích hợp cung cấp.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-secret-token
# Ảnh bìa online: tạo Vercel Blob public store và kết nối vào dự án.
# BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# WaveNet: server-only service account JSON, never NEXT_PUBLIC_.
# GOOGLE_TTS_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# GOOGLE_TTS_VOICE=vi-VN-Wavenet-A
# NARRATION_CACHE_SECRET=use-a-long-random-secret
# TTS_DAILY_LIMIT=2000
# TTS_MONTHLY_CHARACTER_LIMIT=3800000
# Vercel online narration also requires BLOB_READ_WRITE_TOKEN.
